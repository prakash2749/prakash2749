    <dc:identifier id="id">king-of-teeth-blood-code-1</dc:identifier>
    <dc:title>King of Teeth</dc:title>
    <dc:language>en</dc:language>
    <dc:creator id="creator">Aurelia Thorn</dc:creator>
    <dc:description>Every woman he feeds on forgets him. She's the one who stayed. A vampire king hunting his father's killer. A half-wolf bartender hunting hers. A blood pact, a traitor in the house, and a monster who has never once been seen for what he is, until now.</dc:description>
    <dc:publisher>Aurelia Thorn</dc:publisher>
    <dc:date>2026</dc:date>
    <dc:rights>Copyright © 2026 Aurelia Thorn. All rights reserved.</dc:rights>
    <dc:subject>Fiction / Romance / Paranormal / Vampires</dc:subject>
    <dc:subject>Fiction / Romance / Dark</dc:subject>
